# Copy to .streamlit/secrets.toml locally, or paste into the Secrets box in
# the Streamlit Cloud app settings. NEVER commit a real secrets.toml.

admin_password = "choose-a-long-random-string"

# Durable storage for the live study. Without these two entries the app falls
# back to a local file, which does NOT survive a container restart on
# Streamlit Cloud.
sheet_id = "the-id-from-your-google-sheet-url"

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
